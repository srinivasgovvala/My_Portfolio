# Django Settings
SECRET_KEY=generate-a-secure-random-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=portfolio.settings.production

# Allowed Hosts & CSRF for Vercel
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database (Neon Serverless PostgreSQL / Render / Supabase)
# Format: postgresql://username:password@hostname:port/database_name?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-10.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# AI Chatbot (OpenRouter API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Social & Profile links
GITHUB_URL=https://github.com/NagasrinivasGovvala
LINKEDIN_URL=https://linkedin.com/in/nagasrinivas-govvala
CONTACT_EMAIL=nagasrinivas@email.com

# Email Settings (Optional - for contact form email delivery)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=your_email@gmail.com
